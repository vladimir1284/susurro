# Susurro core configuration. Copy to core.toml and edit.

[server]
host = "127.0.0.1"
port = 8723
# Shared token for both WebSocket endpoints and the console URL.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(16))"
token = ""
profiles = "profiles"

[stt]
# "fake" needs no model and replays a script. "whisper" uses faster-whisper.
# "whispercpp" talks to a whisper.cpp `whisper-server` at base_url.
backend = "whisper"
# Only the default: a session takes its language from its profile.
language = "en"
# base_url = "http://127.0.0.1:8081"   # whispercpp only
# Leave unset to take the per-language default from core/stt/whisper.py.
# model = "small.en"
compute_type = "int8"

[session]
# Recording is OFF by default and on purpose: this project's argument is that a
# conversation stays on machines you own, and writing every meeting to disk
# unasked would undercut it. When on, the console says so and each session
# lands in one directory that is easy to find and delete.
record = false
directory = "sessions"

[vad]
# Per-lane voice activity detection. It supplies segment boundaries and, on the
# far lane, the end-of-turn event that starts a hint before you ask for one.
# "silero" needs: pip install --no-deps silero-vad onnxruntime
# "energy" is a plain loudness threshold: no model, but it cannot tell a voice
# from a door. "off" leaves hints manual.
backend = "silero"
threshold = 0.5
# Consecutive 32 ms windows before an utterance opens and before it closes.
# The closing number is the one that matters: too low and end-of-turn fires in
# the middle of a sentence, during a breath. 24 is about 0.77 s; on one recorded
# call 16 (0.5 s) cut a question at its comma, and 31 or 47 only added delay.
start_windows = 2
end_windows = 24
# With loudspeakers the mic also hears the far voice. While the far lane is loud,
# mic frames quieter than this multiple of it are silenced. 0 turns it off. A
# quiet user talking over the other person can lose words at 2.0; headphones are
# the better fix.
bleed_ratio = 2.0
# Raw RMS under which the far lane counts as silent and the rule stands down. It
# depends on capture gain: far speech measured 400-950 and idle noise 50-125 on
# two recorded calls, at one gain. Raise it if idle noise trips the rule.
bleed_far_floor = 250

[llm]
# "fake" returns canned text. "openai" talks to any OpenAI-compatible server:
# llama.cpp's server, Ollama, vLLM, LM Studio.
backend = "openai"
base_url = "http://127.0.0.1:8080"
model = "local"
temperature = 0.3
